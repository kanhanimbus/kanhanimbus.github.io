---
import { getCollection, getEntry, render } from "astro:content";
const Logs = await getCollection('blogLogs');
---

<div class="bgColorCont">
    <div class="titleLogs">
      <h1>Logs of things I'm working on</h1>
    </div>
    <div class="articleNames">
      <ul>
      {Logs.map(post => (
      <li><a href={`/writings/logs/${post.id}`} class = "linkLogs">{post.data.title}</a><br>{post.data.description}</li>
      ))}
      </ul>
    </div>
</div>

<style>
  ul {
    list-style-type: none;
    line-height: 24px;
  }
  li {
    border-radius: 30px;
    background-color: #fcbe14;
    color: black;
    margin-top: 5px;
    margin-bottom: 5px;
    padding-top: 8px;
    padding-left: 25px;
    padding-bottom: 8px;
    font-size: 15px;
    text-shadow: none; 
    box-shadow: 1px 1px 5px orange, 1px 1px 5px black;
  }
  .linkLogs {
    font-size: 20px;
  }
  .titleLogs {
        border: 2px solid #FFcb3b;
        border-radius: 30px;
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        font-variant: small-caps;
        background-color: #1b1bad;
        color: #ffcb3b;
        text-shadow: 1px 1px 5px orange, 1px 1px 5px black; 
        box-shadow: 1px 1px 5px orange, 1px 1px 5px black;
  }
  .articleNames {
        padding-left: 16px;
        padding-right: 16px;
        border: 2px solid #ffcb3b;
        border-radius: 30px;
        flex-direction: column;
        flex: 9 1 1;
        background-color: #1b1bad;
        overflow: auto;
        font-size: 20px;
        text-shadow: 1px 1px 5px orange, 1px 1px 5px black; 
        box-shadow: 1px 1px 5px orange, 1px 1px 5px black;
  }
  .bgColorCont {
        border-radius: 30px;
        background-color: #1b1bad;
        display: flex;
        flex-direction: column;
        flex: 1;
        /* text-shadow: 1px 1px 5px orange, 1px 1px 5px black; 
        box-shadow: 1px 1px 5px orange, 1px 1px 5px black; */
    }
    
    @media screen and (max-device-aspect-ratio: 1/1) {
      .titleLogs {
        border: 2px solid #FFcb3b;
        border-radius: 30px;
        display: flex;
        flex-direction: column;
        flex: 1 1 0;
        text-align: center;
        font-size: 40px;
        font-weight: bold;
        font-variant: small-caps;
        background-color: #1b1bad;
        color: #ffcb3b;
        text-shadow: 1px 1px 5px orange, 1px 1px 5px black; 
        box-shadow: 1px 1px 5px orange, 1px 1px 5px black;
  }
  .articleNames {
        padding-left: 16px;
        padding-right: 16px;
        border: 2px solid #ffcb3b;
        border-radius: 30px;
        flex-direction: column;
        flex: 9 1 1;
        background-color: #1b1bad;
        overflow: auto;
        font-size: 20px;
        text-shadow: 1px 1px 5px orange, 1px 1px 5px black; 
        box-shadow: 1px 1px 5px orange, 1px 1px 5px black;       
  }
  li {
    font-size: 20px;
    line-height: 30px;
  }
  .linkLogs {
    font-size: 25px;
  }
    }
</style>