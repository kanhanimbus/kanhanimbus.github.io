---
import Layout from "@/layouts/Layout.astro"
import ArticleLayout from "@/layouts/WritingsLayout.astro"
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blogLogs');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<head><title>{post.data.title}</title></head>
<Layout>
  <ArticleLayout>
    <nav aria-label="Breadcrumb" class="breadcrumb" slot = "goBack">
    <ol>
      <li class="breadcrumbs__item">
        <a href="/" class="breadcrumb__link">Home</a>
        </li>
        <li class = "breadcrumb-separator">></li>
        <li class="breadcrumbs__item">
        <a href="/writings" class="breadcrumb__link">Writings</a>
        </li>
        <li class = "breadcrumb-separator">></li>
        <li>
          <a href="/writings/logs" class="breadcrumb__link">Logs</a>
      </li>
      <li class = "breadcrumb-separator">></li>
      <li><span aria-current="page">{post.data.title}</span></li>
    </ol>
    </nav>
      <div class = "headingLogs" slot = "title">
        <span>{post.data.title}
          </span>
      </div>
      <Content slot = "bodyArticle"/>
  </ArticleLayout>
</Layout>

<style>
  .breadcrumb {
  padding: 5px;
  /* flex: 1; */
  /* display: flex; */
  align-items: center;
}

.breadcrumb ol {
  display: flex;
  flex-wrap: wrap;
  list-style: none;
  margin: 0;
  padding: 0;
  align-items: center;
  flex: 1;  
}
.breadcrumb-separator {
  display: inline-block;
  margin: 0 0.25rem;
  /* content: "→"; */
  background-color: #1b1bad;
  color: #FFe52c;
  box-shadow: none;
}

li {
  background-color: #fcbe14;
  border-radius: 30px;
  text-shadow: none;
  padding: 10px;
  color: #1b1bad;
  box-shadow: 1px 1px 5px orange, 1px 1px 5px black;
  font-size: 18px;
  font-style: italic;
  font-weight: bolder;
}

  .directoryDisp {
        border-radius: 30px;
        background-color: #1b1bad;
        width: 3%;
        aspect-ratio: 1/1;
        cursor: pointer;
        display: block;
        text-align: center;
        border: 2px solid #FFe52c;
        color: #FFe52c
    }
  .headingLogs {
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 50px;
    flex: 1 1 0;
    text-align: center;
  }
  span {
   display: inline-block;
   vertical-align: middle;
   line-height: normal;
  }
  a {
    text-decoration: none;
  }
  
  @media screen and (max-device-aspect-ratio: 1/1) {
    li {
      font-size: 20px;
    }
  }
</style>